---
/**
 * Base layout for every shop page: SEO head, announcement bar, header, footer and the
 * small cart script. Pages pass their title, description and optional JSON-LD.
 */
import '../styles/global.css';
import { AnnouncementBar } from '../components/layout/AnnouncementBar/AnnouncementBar';
import { SiteHeader } from '../components/layout/SiteHeader/SiteHeader';
import { SiteFooter } from '../components/layout/SiteFooter/SiteFooter';
import { site } from '../config/site';
import { mainNav, finderLink, footerNav } from '../config/navigation';
import { routes, url } from '../lib/url';

interface Props {
  /** Full <title>, max ~60 characters (SEO guide templates) */
  title: string;
  /** Meta description, 140–155 characters */
  description: string;
  /** Social share image (1200 × 630), path under /public */
  ogImage?: string;
  /** Extra JSON-LD objects for this page */
  jsonLd?: Record<string, unknown>[];
  /** Force noindex (cart, checkout, search) */
  noindex?: boolean;
  currentHref?: string;
}

const { title, description, ogImage = 'images/hero/filtrirana-voda-iz-slavine-1680.webp', jsonLd = [], noindex = false, currentHref } = Astro.props;

// Test phase: the whole site stays out of search engines until launch (SEO guide pre-launch checklist).
const siteNoindex = (import.meta.env.PUBLIC_NOINDEX ?? 'true') !== 'false';
const robots = noindex || siteNoindex ? 'noindex, nofollow' : 'index, follow';

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(url(ogImage), Astro.site).toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL(url('images/brand/vodanatura-logo.png'), Astro.site).toString(),
  email: site.contact.email,
  telephone: site.contact.phoneHref || undefined,
  openingHours: site.contact.openingHours,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address.street,
    postalCode: site.contact.address.postalCode,
    addressLocality: site.contact.address.city,
    addressCountry: site.contact.address.country,
  },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: site.locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site.url}/pretraga/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const schemas = [organization, website, ...jsonLd];

const announcement = [
  { icon: 'cash' as const, text: 'Plaćate tek kad stigne – pouzećem' },
  { icon: 'truck' as const, text: `Dostava ${site.delivery.courier} kurirskom službom širom Srbije` },
  { icon: 'phone' as const, text: `Pomoć pri izboru: ${site.contact.phone}` },
];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#1F752B" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="vn-skip-link" href="#main">Preskoči na sadržaj</a>
    <AnnouncementBar items={announcement} />
    <SiteHeader
      homeHref={routes.home()}
      logoSrc={url('images/brand/vodanatura-logo.svg')}
      searchAction={routes.search()}
      helpHref={url('#pomoc')}
      compareHref={routes.compare()}
      cartHref={routes.cart()}
      phoneHref={site.contact.phoneHref ? `tel:${site.contact.phoneHref}` : undefined}
      nav={mainNav}
      finder={finderLink}
      currentHref={currentHref}
    />

    <main id="main">
      <slot />
    </main>

    <SiteFooter
      logoSrc={url('images/brand/vodanatura-logo-inverse.svg')}
      about={`${site.tagline}. VodaNatura radi u saradnji sa kompanijom ${site.partner.name} iz Subotice, koja pakuje i šalje porudžbine.`}
      groups={[footerNav.shop, footerNav.buying, footerNav.about]}
      contact={{
        phone: site.contact.phone,
        phoneHref: site.contact.phoneHref ? `tel:${site.contact.phoneHref}` : undefined,
        email: site.contact.email,
        hours: site.contact.hours,
        address: [site.contact.address.street, `${site.contact.address.postalCode} ${site.contact.address.city}`],
      }}
      legal={footerNav.legal}
    />

    <div class="vn-toast" data-toast role="status" aria-live="polite" hidden></div>

    <script>
      import '../scripts/cart';
    </script>
  </body>
</html>

<style is:global>
  .vn-toast {
    position: fixed;
    left: 50%;
    bottom: var(--vn-space-6);
    z-index: 200;
    transform: translateX(-50%);
    max-width: calc(100% - 2 * var(--vn-space-4));
    padding: var(--vn-space-3) var(--vn-space-5);
    border-radius: var(--vn-radius-sm);
    background: var(--vn-color-bg-inverse);
    color: var(--vn-color-text-inverse);
    font-size: var(--vn-text-body-sm-size);
    font-weight: var(--vn-font-weight-semibold);
    box-shadow: var(--vn-shadow-md);
  }
  .vn-toast[hidden] { display: none; }
</style>
